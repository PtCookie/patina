root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true
max_line_length = 120

[*.{css,json}]
indent_size = 4

# The Android library is linted the way the apps that vendor it lint it: ktlint's default style, 4 spaces.
[*.{kt,kts}]
indent_size = 4
ktlint_code_style = ktlint_official
ktlint_function_naming_ignore_when_annotated_with = Composable

# The gallery app is a harness, not the library: only public/android is linted (see scripts/android-gallery).
[scripts/android-gallery/app/src/**.kt]
ktlint = disabled
