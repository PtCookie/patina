// Development gallery for the Patina Slint library. Not shipped. Render it with `pnpm slint:shot` (see AGENTS.md).
import { Theme, Typography, Alert, AlertVariant, Badge, BadgeVariant, Button, ButtonVariant, Card, Checkbox, Collapsible, Input, Kbd, Menu, MenuItem, MenuLabel, MenuSeparator, PaneHeader, ListRow, Select, Separator, Switch, Table, Tabs, Toggle, TreeRow, Tooltip } from "@patina";

// load-data reaches a global only when the file exports it.
export { Theme }

component Diff inherits Rectangle {
    in property <string> text;
    in property <color> fill: transparent;
    height: 18px;
    background: root.fill;
    HorizontalLayout {
        padding-left: Theme.space-3;
        Text {
            text: root.text;
            color: Theme.current.foreground;
            font-family: Typography.mono-sm.font-family;
            font-size: 12px;
            vertical-alignment: center;
        }
    }
}

// The DesktopShell preview built from the library.
export component Shell inherits Window {
    width: 960px;
    height: 440px;
    background: Theme.current.background;

    VerticalLayout {
        Rectangle {
            height: 41px;
            background: Theme.current.sidebar;
            HorizontalLayout {
                padding-left: Theme.space-3;
                padding-right: Theme.space-2;
                spacing: Theme.space-1;
                alignment: stretch;
                Text {
                    text: "pathpoint";
                    color: Theme.current.foreground;
                    font-family: Theme.font-heading;
                    font-size: 13px;
                    font-weight: 600;
                    vertical-alignment: center;
                    horizontal-stretch: 0;
                }
                Rectangle { width: Theme.space-2; horizontal-stretch: 0; }
                Button { text: "Fetch"; variant: ButtonVariant.ghost; icon: @image-url("../../node_modules/@phosphor-icons/core/assets/regular/arrow-down.svg"); }
                Button { text: "Push"; variant: ButtonVariant.ghost; icon: @image-url("../../node_modules/@phosphor-icons/core/assets/regular/arrow-up.svg"); }
                Button { text: "main"; variant: ButtonVariant.ghost; icon: @image-url("../../node_modules/@phosphor-icons/core/assets/regular/git-branch.svg"); }
                Rectangle { }
                Input {
                    placeholder-text: "Filter";
                    width: 180px;
                    horizontal-stretch: 0;
                }
                Button {
                    text: "Commit";
                    icon: @image-url("../../node_modules/@phosphor-icons/core/assets/regular/git-commit.svg");
                }
            }
            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Theme.current.border;
            }
        }

        HorizontalLayout {
            Rectangle {
                width: 199px;
                background: Theme.current.sidebar;
                VerticalLayout {
                    alignment: start;
                    PaneHeader { text: "Workspace"; }
                    VerticalLayout {
                        padding-left: Theme.space-1-5;
                        padding-right: Theme.space-1-5;
                        TreeRow { text: "Changes"; count: "4"; selected: true; icon: @image-url("../../node_modules/@phosphor-icons/core/assets/regular/file.svg"); }
                        TreeRow { text: "History"; icon: @image-url("../../node_modules/@phosphor-icons/core/assets/regular/clock-counter-clockwise.svg"); }
                        TreeRow { text: "Stashes"; count: "2"; icon: @image-url("../../node_modules/@phosphor-icons/core/assets/regular/archive.svg"); }
                    }
                    PaneHeader { text: "Branches"; }
                    VerticalLayout {
                        padding-left: Theme.space-1-5;
                        padding-right: Theme.space-1-5;
                        TreeRow { text: "main"; icon: @image-url("../../node_modules/@phosphor-icons/core/assets/regular/git-branch.svg"); }
                        TreeRow { text: "feature/diff-view"; icon: @image-url("../../node_modules/@phosphor-icons/core/assets/regular/git-branch.svg"); }
                        TreeRow { text: "v0.4.2"; icon: @image-url("../../node_modules/@phosphor-icons/core/assets/regular/tag.svg"); }
                    }
                }
            }
            Separator { orientation: Orientation.vertical; }
            Rectangle {
                width: 259px;
                VerticalLayout {
                    alignment: start;
                    PaneHeader {
                        text: "Staged · 2";
                        Button {
                            variant: ButtonVariant.ghost;
                            icon: @image-url("../../node_modules/@phosphor-icons/core/assets/regular/arrow-down.svg");
                            tooltip: "Unstage all";
                        }
                    }
                    ListRow { text: "diff-view.slint"; detail: "ui/components"; selected: true; }
                    ListRow { text: "repo.rs"; detail: "src/git"; }
                    PaneHeader { text: "Unstaged · 2"; }
                    ListRow { text: "Cargo.toml"; detail: "."; }
                    ListRow { text: "theme.slint"; detail: "ui"; }
                }
            }
            Separator { orientation: Orientation.vertical; }
            VerticalLayout {
                padding: Theme.space-4;
                spacing: Theme.space-3;
                alignment: start;
                HorizontalLayout {
                    spacing: Theme.space-2;
                    alignment: start;
                    Text {
                        text: "diff-view.slint";
                        color: Theme.current.foreground;
                        font-family: Theme.font-heading;
                        font-size: 14px;
                        font-weight: 500;
                        vertical-alignment: center;
                    }
                    Badge { text: "12"; variant: BadgeVariant.success; icon: @image-url("../../node_modules/@phosphor-icons/core/assets/regular/plus.svg"); }
                    Badge { text: "3"; variant: BadgeVariant.destructive; icon: @image-url("../../node_modules/@phosphor-icons/core/assets/regular/minus.svg"); }
                }
                Rectangle {
                    background: Theme.current.card;
                    border-radius: Theme.radius-xl;
                    clip: true;
                    VerticalLayout {
                        Diff { text: "@@ -14,6 +14,9 @@"; fill: Theme.current.muted; }
                        Diff { text: "    in property <string> path;"; }
                        Diff { text: "-   background: #ffffff;"; fill: Theme.current.destructive-muted; }
                        Diff { text: "+   background: Theme.current.card;"; fill: Theme.current.success-muted; }
                        Diff { text: "+   border-radius: Radius.r-2xl;"; fill: Theme.current.success-muted; }
                        Diff { text: "    callback stage();"; }
                    }
                }
            }
        }
    }
}

// Every variant and state of the tier 1 components, for visual review.
export component Board inherits Window {
    width: 780px;
    height: 400px;
    background: Theme.current.background;

    VerticalLayout {
        padding: Theme.space-4;
        spacing: Theme.space-4;
        alignment: start;

        HorizontalLayout {
            spacing: Theme.space-2;
            alignment: start;
            Button { text: "Commit"; }
            Button { text: "Outline"; variant: ButtonVariant.outline; }
            Button { text: "Secondary"; variant: ButtonVariant.secondary; }
            Button { text: "Ghost"; variant: ButtonVariant.ghost; }
            Button { text: "Delete branch"; variant: ButtonVariant.destructive; }
            Button { text: "Link"; variant: ButtonVariant.link; }
            Button { text: "Disabled"; enabled: false; }
            Button { icon: @image-url("../../node_modules/@phosphor-icons/core/assets/regular/plus.svg"); variant: ButtonVariant.outline; tooltip: "New branch"; }
        }
        HorizontalLayout {
            spacing: Theme.space-2;
            alignment: start;
            Button { text: "Pill primary"; pill: true; }
            Button { text: "Pill outline"; pill: true; variant: ButtonVariant.outline; }
            Button { text: "Fetch"; icon: @image-url("../../node_modules/@phosphor-icons/core/assets/regular/arrow-down.svg"); variant: ButtonVariant.outline; }
        }
        HorizontalLayout {
            spacing: Theme.space-2;
            alignment: start;
            Badge { text: "Default"; }
            Badge { text: "Secondary"; variant: BadgeVariant.secondary; }
            Badge { text: "Outline"; variant: BadgeVariant.outline; }
            Badge { text: "Merged"; variant: BadgeVariant.success; icon: @image-url("../../node_modules/@phosphor-icons/core/assets/regular/check-circle.svg"); }
            Badge { text: "Conflict"; variant: BadgeVariant.warning; icon: @image-url("../../node_modules/@phosphor-icons/core/assets/regular/tag.svg"); }
            Badge { text: "Failed"; variant: BadgeVariant.destructive; icon: @image-url("../../node_modules/@phosphor-icons/core/assets/regular/x.svg"); }
            Badge { text: "Info"; variant: BadgeVariant.info; icon: @image-url("../../node_modules/@phosphor-icons/core/assets/regular/gear.svg"); }
        }
        HorizontalLayout {
            spacing: Theme.space-3;
            alignment: start;
            Input { placeholder-text: "Filter"; width: 180px; }
            Input { placeholder-text: "Pill"; width: 140px; pill: true; }
            Input { text: "origin/main"; width: 140px; }
            Input { text: "bad name"; invalid: true; width: 140px; }
            Input { placeholder-text: "Disabled"; enabled: false; width: 120px; }
        }
        HorizontalLayout {
            spacing: Theme.space-1;
            alignment: start;
            Kbd { text: "⌘"; }
            Kbd { text: "K"; }
            Kbd { text: "Shift"; }
            Kbd { text: "Enter"; }
            Rectangle { width: Theme.space-6; }
            Rectangle {
                background: Theme.current.foreground;
                width: 0px;
            }
        }
        Tooltip { text: "Stage all changes"; shortcut: "⌘S"; horizontal-stretch: 0; width: self.preferred-width; }
        HorizontalLayout {
            height: 20px;
            Text { text: "Changes"; color: Theme.current.foreground; vertical-alignment: center; horizontal-stretch: 0; }
            Separator { orientation: Orientation.vertical; }
            Text { text: "History"; color: Theme.current.foreground; vertical-alignment: center; horizontal-stretch: 0; }
        }
        Separator { }
    }
}

// Every state of the tier 2 components, for visual review. The Menu is drawn open in place; a Select and a PopupWindow
// cannot be rendered headless, so check those through the MCP server (see AGENTS.md).
export component Controls inherits Window {
    width: 780px;
    height: 460px;
    background: Theme.current.background;

    VerticalLayout {
        padding: Theme.space-4;
        spacing: Theme.space-4;
        alignment: start;

        HorizontalLayout {
            spacing: Theme.space-6;
            alignment: start;
            Checkbox { text: "Unchecked"; }
            Checkbox { text: "Checked"; checked: true; }
            Checkbox { text: "Invalid"; invalid: true; }
            Checkbox { text: "Disabled"; checked: true; enabled: false; }
            Checkbox { }
        }
        HorizontalLayout {
            spacing: Theme.space-6;
            alignment: start;
            Switch { text: "Off"; }
            Switch { text: "On"; checked: true; }
            Switch { text: "Disabled"; checked: true; enabled: false; }
            Switch { }
        }
        HorizontalLayout {
            spacing: Theme.space-6;
            alignment: start;
            Tabs { model: ["Changes", "History", "Stashes"]; current-index: 0; }
            Tabs { model: ["Unified", "Split"]; current-index: 1; }
            Tabs { model: ["One", "Two"]; enabled: false; }
        }
        HorizontalLayout {
            spacing: Theme.space-3;
            alignment: start;
            Select { model: ["main", "develop", "feature/diff-view"]; current-index: 0; width: 180px; }
            Select { model: ["main", "develop"]; placeholder-text: "Branch"; width: 140px; }
            Select { model: ["main", "develop"]; current-index: 1; pill: true; width: 140px; }
            Select { model: ["main"]; placeholder-text: "Invalid"; invalid: true; width: 120px; }
            Select { model: ["main"]; current-index: 0; enabled: false; width: 120px; }
        }
        HorizontalLayout {
            spacing: Theme.space-6;
            alignment: start;
            Menu {
                width: 220px;
                horizontal-stretch: 0;
                MenuLabel { text: "Branch"; }
                MenuItem { text: "Checkout"; shortcut: "⌘O"; icon: @image-url("../../node_modules/@phosphor-icons/core/assets/regular/git-branch.svg"); }
                MenuItem { text: "Rename"; shortcut: "F2"; icon: @image-url("../../node_modules/@phosphor-icons/core/assets/regular/tag.svg"); highlighted: true; }
                MenuItem { text: "Merge into main"; enabled: false; icon: @image-url("../../node_modules/@phosphor-icons/core/assets/regular/git-commit.svg"); }
                MenuSeparator { }
                MenuItem { text: "Delete"; destructive: true; icon: @image-url("../../node_modules/@phosphor-icons/core/assets/regular/x.svg"); }
            }
            Table {
                horizontal-stretch: 1;
                height: 150px;
                columns: [
                    { title: "Commit", width: 72px, mono: true },
                    { title: "Message" },
                    { title: "Author", width: 80px },
                    { title: "Files", width: 40px, numeric: true },
                ];
                rows: [
                    ["a1b2c3d", "Add the diff view", "Minsup", "4"],
                    ["e4f5a6b", "Fix the staging bug", "Minsup", "1"],
                    ["0f9e8d7", "Tighten the radius scale", "Claude", "12"],
                    ["7c6b5a4", "Update the lockfile", "Minsup", "1"],
                ];
                selected-row: 1;
            }
        }
    }
}

// Every state of the tier 3 components, for visual review.
export component Panels inherits Window {
    width: 780px;
    height: 520px;
    background: Theme.current.background;

    HorizontalLayout {
        padding: Theme.space-4;
        spacing: Theme.space-4;
        VerticalLayout {
            spacing: Theme.space-3;
            alignment: start;
            Alert { title: "Heads up"; description: "Alerts pair a tone with an icon and a word."; icon: @image-url("../../node_modules/@phosphor-icons/core/assets/regular/info.svg"); }
            Alert { title: "Push rejected"; description: "The remote has commits you do not have."; variant: AlertVariant.destructive; icon: @image-url("../../node_modules/@phosphor-icons/core/assets/regular/x-circle.svg"); }
            Alert { title: "Merged"; variant: AlertVariant.success; icon: @image-url("../../node_modules/@phosphor-icons/core/assets/regular/check-circle.svg"); }
            Alert {
                title: "Conflicts in 2 files";
                description: "Resolve them before you commit.";
                variant: AlertVariant.warning;
                icon: @image-url("../../node_modules/@phosphor-icons/core/assets/regular/warning.svg");
                Button { text: "Resolve"; variant: ButtonVariant.outline; }
            }
            Alert { title: "Update available"; variant: AlertVariant.info; icon: @image-url("../../node_modules/@phosphor-icons/core/assets/regular/info.svg"); }
        }
        VerticalLayout {
            spacing: Theme.space-3;
            alignment: start;
            Card {
                title: "Repository";
                description: "Settings for this checkout.";
                Checkbox { text: "Fetch on focus"; checked: true; }
                Separator { }
                HorizontalLayout {
                    spacing: Theme.space-2;
                    alignment: end;
                    Button { text: "Cancel"; variant: ButtonVariant.ghost; }
                    Button { text: "Save"; }
                }
            }
            HorizontalLayout {
                spacing: Theme.space-1;
                alignment: start;
                Toggle { text: "Wrap"; }
                Toggle { text: "Hidden"; checked: true; }
                Toggle { text: "Outline"; outline: true; }
                Toggle { text: "Outline on"; outline: true; checked: true; }
                Toggle { icon: @image-url("../../node_modules/@phosphor-icons/core/assets/regular/tag.svg"); tooltip: "Show tags"; }
                Toggle { text: "Off"; enabled: false; }
            }
            Collapsible {
                text: "Branches";
                open: true;
                TreeRow { text: "main"; icon: @image-url("../../node_modules/@phosphor-icons/core/assets/regular/git-branch.svg"); }
                TreeRow { text: "develop"; icon: @image-url("../../node_modules/@phosphor-icons/core/assets/regular/git-branch.svg"); }
            }
            Separator { }
            Collapsible { text: "Tags"; }
        }
    }
}

// Callbacks and focus, for checking through the MCP server (see AGENTS.md).
export component Interactive inherits Window {
    width: 360px;
    height: 560px;
    background: Theme.current.background;
    property <int> clicks: 0;
    property <string> echo: "";
    property <int> selected: 0;
    property <bool> checked: false;
    property <bool> on: false;
    property <int> tab: 0;
    property <int> option: -1;
    property <int> picked-row: -1;
    property <string> menu: "";
    property <bool> pinned: false;
    property <bool> expanded: false;

    VerticalLayout {
        padding: Theme.space-4;
        spacing: Theme.space-2;
        alignment: start;
        HorizontalLayout {
            spacing: Theme.space-2;
            alignment: start;
            Button { text: "First"; clicked => { root.clicks += 1; } }
            Button { text: "Second"; variant: ButtonVariant.outline; clicked => { root.clicks += 10; } }
            Button { text: "Off"; enabled: false; clicked => { root.clicks += 1000; } }
        }
        Input { placeholder-text: "Type"; edited(text) => { root.echo = text; } }
        Text { text: "clicks=\{root.clicks} echo=\{root.echo} selected=\{root.selected}"; color: Theme.current.foreground; accessible-role: AccessibleRole.text; accessible-label: self.text; }
        TreeRow { text: "One"; selected: root.selected == 1; clicked => { root.selected = 1; } }
        TreeRow { text: "Two"; selected: root.selected == 2; clicked => { root.selected = 2; } }
        Text { text: "checked=\{root.checked ? 1 : 0} on=\{root.on ? 1 : 0} tab=\{root.tab} option=\{root.option} row=\{root.picked-row} menu=\{root.menu}"; color: Theme.current.foreground; accessible-role: AccessibleRole.text; accessible-label: self.text; }
        HorizontalLayout {
            spacing: Theme.space-3;
            alignment: start;
            Checkbox { text: "Check"; toggled(value) => { root.checked = value; } }
            Switch { text: "Switch"; toggled(value) => { root.on = value; } }
        }
        Tabs { model: ["A", "B", "C"]; selected(index) => { root.tab = index; } }
        HorizontalLayout {
            spacing: Theme.space-3;
            alignment: start;
            select := Select { model: ["main", "develop", "release"]; placeholder-text: "Branch"; width: 140px; selected(index) => { root.option = index; } }
            Button { text: "Menu"; variant: ButtonVariant.outline; clicked => { menu-popup.show(); } }
        }
        HorizontalLayout {
            spacing: Theme.space-3;
            alignment: start;
            Toggle { text: "Pin"; toggled(value) => { root.pinned = value; } }
            Collapsible { text: "More"; width: 120px; toggled(value) => { root.expanded = value; } Text { text: "Details"; color: Theme.current.foreground; } }
        }
        Text { text: "pinned=\{root.pinned ? 1 : 0} expanded=\{root.expanded ? 1 : 0}"; color: Theme.current.foreground; accessible-role: AccessibleRole.text; accessible-label: self.text; }
        Table {
            height: 84px;
            columns: [{ title: "Name" }, { title: "Count", width: 56px, numeric: true }];
            rows: [["alpha", "1"], ["beta", "22"]];
            row-clicked(index) => { root.picked-row = index; }
        }
    }

    menu-popup := PopupWindow {
        x: 200px;
        y: 120px;
        width: 180px;
        height: 90px;
        Menu {
            MenuItem { text: "Rename"; clicked => { root.menu = "rename"; menu-popup.close(); } }
            MenuItem { text: "Delete"; destructive: true; clicked => { root.menu = "delete"; menu-popup.close(); } }
        }
    }
}
