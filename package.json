{
    "name": "patina",
    "description": "Design system of PtCookie",
    "private": true,
    "license": "MIT",
    "author": {
        "name": "Minsup Ju",
        "email": "me@ptcookie.net",
        "url": "https://www.ptcookie.net/"
    },
    "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621",
    "type": "module",
    "scripts": {
        "prepare": "lefthook install",
        "build": "node --import tsx scripts/build.ts",
        "build:files": "node --import tsx scripts/build.ts --no-site",
        "site:dev": "pnpm --filter @patina/site dev",
        "smoke": "node --import tsx scripts/smoke.ts",
        "deploy": "pnpm build && wrangler deploy",
        "typecheck": "tsc --noEmit",
        "lint": "eslint",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest",
        "check": "pnpm typecheck && pnpm lint && pnpm format:check && vitest run",
        "slint:shot": "node --import tsx scripts/slint-shot.ts"
    },
    "devDependencies": {
        "@base-ui/react": "^1.9.0",
        "@eslint/js": "^10.0.1",
        "@phosphor-icons/core": "^2.1.1",
        "@phosphor-icons/react": "^2.1.10",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/react": "^16.3.3",
        "@types/node": "^24.19.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitest/eslint-plugin": "^1.6.27",
        "class-variance-authority": "^0.7.1",
        "cn": "^0.5.0",
        "eslint": "^10.12.0",
        "globals": "^17.13.0",
        "jiti": "^2.7.0",
        "jsdom": "^30.1.3",
        "lefthook": "^2.2.2",
        "prettier": "3.9.6",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "recharts": "3.8.0",
        "slint-ui": "^1.18.1",
        "tsx": "^4.23.15",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.71.2",
        "vitest": "^4.1.11",
        "wrangler": "^4.151.0"
    },
    "engines": {
        "node": "^22.12.0 || ^24.11.0"
    }
}
