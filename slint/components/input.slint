import { Theme, Typography } from "../tokens.slint";
import { FocusRing } from "focus-ring.slint";

// A compact single-line field: borderless on the `control` fill, 28px tall, radius-md (`pill` for fully round).
// Focus draws the 2px `ring` outline; `invalid` adds the 3px `invalid-ring` and the `invalid-border`.
export component Input inherits Rectangle {
    in-out property <string> text <=> field.text;
    in property <string> placeholder-text;
    in property <bool> enabled: true;
    in property <bool> read-only: false;
    in property <bool> invalid: false;
    in property <bool> pill: false;
    out property <bool> has-focus: field.has-focus;
    callback edited(string);
    callback accepted(string);

    property <length> corner: root.pill ? Theme.radius-full : Theme.radius-md;

    min-height: Theme.compact-control;
    vertical-stretch: 0;
    min-width: 64px;
    accessible-role: AccessibleRole.text-input;
    accessible-label: root.placeholder-text;
    accessible-placeholder-text: root.placeholder-text;
    accessible-read-only: root.read-only;
    accessible-enabled: root.enabled;
    accessible-value: root.text;

    body := Rectangle {
        y: (parent.height - self.height) / 2;
        width: parent.width;
        height: Theme.compact-control;
        background: Theme.current.control;
        border-radius: root.corner;
        border-width: 1px;
        border-color: root.invalid ? Theme.current.invalid-border : transparent;
        opacity: root.enabled ? 1 : 0.5;

        HorizontalLayout {
            padding-left: Theme.compact-pad;
            padding-right: Theme.compact-pad;
            Rectangle {
                field := TextInput {
                    width: parent.width;
                    height: parent.height;
                    enabled: root.enabled;
                    read-only: root.read-only;
                    single-line: true;
                    color: Theme.current.foreground;
                    selection-background-color: Theme.current.primary;
                    selection-foreground-color: Theme.current.primary-foreground;
                    font-family: Typography.compact-body.font-family;
                    font-size: Typography.compact-body.font-size;
                    font-weight: Typography.compact-body.font-weight;
                    vertical-alignment: center;
                    edited => { root.edited(self.text); }
                    accepted => { root.accepted(self.text); }
                }

                if field.text == "" && root.placeholder-text != "" : Text {
                    text: root.placeholder-text;
                    color: Theme.current.muted-foreground;
                    font-family: Typography.compact-body.font-family;
                    font-size: Typography.compact-body.font-size;
                    font-weight: Typography.compact-body.font-weight;
                    vertical-alignment: center;
                    width: parent.width;
                    height: parent.height;
                    overflow: elide;
                }
            }
        }

        if root.invalid : Rectangle {
            x: -3px;
            y: -3px;
            width: parent.width + 6px;
            height: parent.height + 6px;
            border-radius: root.corner + 3px;
            border-width: 3px;
            border-color: Theme.current.invalid-ring;
        }

        if field.has-focus : FocusRing {
            radius: root.corner;
            host-width: parent.width;
            host-height: parent.height;
        }
    }
}
