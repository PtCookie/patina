import { Theme } from "../tokens.slint";

// The focus indicator: a 2px `ring` outline drawn 2px outside its parent (the web components do the same with
// `outline-offset: 2px`). Place it as the last child of the element that takes focus and bind `visible` to
// keyboard focus; `radius`, `host-width` and `host-height` describe that element.
export component FocusRing inherits Rectangle {
    in property <length> radius: Theme.radius-md;
    // The size of the element that has focus.
    in property <length> host-width;
    in property <length> host-height;

    x: -4px;
    y: -4px;
    width: root.host-width + 8px;
    height: root.host-height + 8px;
    border-radius: root.radius + 4px;
    border-width: 2px;
    border-color: Theme.current.ring;
    background: transparent;
}
