import { Theme, Typography } from "../tokens.slint";

export enum BadgeVariant { primary, secondary, outline, destructive, success, warning, info }

// One or two words of status or metadata: a pill 20px tall with `caption` text. The status variants are a tint with
// their colour as text, never a solid fill, and should always carry an icon (12px) because success, primary and
// destructive differ by hue only.
export component Badge inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <BadgeVariant> variant: BadgeVariant.primary;

    property <color> content-color: root.variant == BadgeVariant.primary ? Theme.current.primary-foreground
        : root.variant == BadgeVariant.secondary ? Theme.current.secondary-foreground
        : root.variant == BadgeVariant.destructive ? Theme.current.destructive
        : root.variant == BadgeVariant.success ? Theme.current.success
        : root.variant == BadgeVariant.warning ? Theme.current.warning
        : root.variant == BadgeVariant.info ? Theme.current.info
        : Theme.current.foreground;

    min-height: 20px;
    vertical-stretch: 0;
    horizontal-stretch: 0;
    preferred-width: row.preferred-width + 2px;
    accessible-role: AccessibleRole.text;
    accessible-label: root.text;

    body := Rectangle {
        y: (parent.height - self.height) / 2;
        width: parent.width;
        height: 20px;
        background: root.variant == BadgeVariant.primary ? Theme.current.primary
            : root.variant == BadgeVariant.secondary ? Theme.current.secondary
            : root.variant == BadgeVariant.destructive ? Theme.current.destructive-muted
            : root.variant == BadgeVariant.success ? Theme.current.success-muted
            : root.variant == BadgeVariant.warning ? Theme.current.warning-muted
            : root.variant == BadgeVariant.info ? Theme.current.info-muted
            : transparent;
        border-radius: Theme.radius-full;
        border-width: 1px;
        border-color: root.variant == BadgeVariant.outline ? Theme.current.border : transparent;

        row := HorizontalLayout {
            alignment: center;
            padding-left: Theme.space-2;
            padding-right: Theme.space-2;
            spacing: Theme.space-1;
            if root.icon.width > 0 : Image {
                source: root.icon;
                colorize: root.content-color;
                width: Theme.icon-sm;
                height: Theme.icon-sm;
                y: (parent.height - self.height) / 2;
            }
            Text {
                text: root.text;
                color: root.content-color;
                font-family: Typography.caption.font-family;
                font-size: Typography.caption.font-size;
                font-weight: Typography.caption.font-weight;
                vertical-alignment: center;
            }
        }
    }
}
