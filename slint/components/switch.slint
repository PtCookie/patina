import { Theme, Typography } from "../tokens.slint";
import { FocusRing } from "focus-ring.slint";

// The compact switch (the web `sm` size): a 28x16 pill track with a 16x12 pill thumb inset 2px. On is `primary`, off
// is `control-strong`; the thumb is `switch-thumb` off and `switch-thumb-checked` on. A switch applies its state
// immediately and never waits for a Save button. Space toggles it from the keyboard.
//
// The component is a transparent slot that is at least 28px tall; the row is centered in it.
export component Switch inherits Rectangle {
    in property <string> text;
    in-out property <bool> checked: false;
    in property <bool> enabled: true;
    out property <bool> has-hover: touch.has-hover;
    callback toggled(bool);

    property <bool> keyboard-focus: false;

    min-height: Theme.compact-control;
    vertical-stretch: 0;
    horizontal-stretch: 0;
    preferred-width: row.preferred-width;
    accessible-role: AccessibleRole.switch;
    accessible-label: root.text;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-enabled: root.enabled;
    accessible-action-default => { root.toggle(); }

    function toggle() {
        root.checked = !root.checked;
        root.toggled(root.checked);
    }

    body := Rectangle {
        y: (parent.height - self.height) / 2;
        width: parent.width;
        height: 16px;
        opacity: root.enabled ? 1 : 0.5;

        row := HorizontalLayout {
            spacing: Theme.space-2;
            alignment: start;
            track := Rectangle {
                width: 28px;
                height: 16px;
                background: root.checked ? Theme.current.primary : Theme.current.control-strong;
                border-radius: Theme.radius-full;

                Rectangle {
                    x: root.checked ? track.width - self.width - 2px : 2px;
                    y: 2px;
                    width: 16px;
                    height: 12px;
                    background: root.checked ? Theme.current.switch-thumb-checked : Theme.current.switch-thumb;
                    border-radius: Theme.radius-full;
                    animate x { duration: 100ms; easing: ease-out; }
                }

                if root.keyboard-focus : FocusRing {
                    radius: Theme.radius-full;
                    host-width: parent.width;
                    host-height: parent.height;
                }
            }
            if root.text != "" : Text {
                text: root.text;
                color: Theme.current.foreground;
                font-family: Typography.compact-body.font-family;
                font-size: Typography.compact-body.font-size;
                font-weight: Typography.compact-body.font-weight;
                vertical-alignment: center;
            }
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
        clicked => { root.toggle(); }
    }

    FocusScope {
        enabled: root.enabled;
        focus-on-click: false;
        focus-gained(reason) => { root.keyboard-focus = reason == FocusReason.tab-navigation; }
        focus-lost(reason) => { root.keyboard-focus = false; }
        key-pressed(event) => {
            if (event.text == " ") {
                root.toggle();
                return accept;
            }
            return reject;
        }
    }
}
