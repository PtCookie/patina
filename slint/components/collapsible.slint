import { Theme, Typography } from "../tokens.slint";
import { FocusRing } from "focus-ring.slint";

// A header row (28px, `compact-label` text) with a caret that turns over when open; the children below it show only
// while `open`. The whole header toggles, and Space or Enter toggle it from the keyboard. The collapsible adds no
// surface of its own: the content keeps its own. For several stacked sections use one Collapsible each and divide
// them with a Separator.
export component Collapsible inherits Rectangle {
    in property <string> text;
    in-out property <bool> open: false;
    in property <bool> enabled: true;
    callback toggled(bool);

    property <bool> keyboard-focus: false;

    preferred-height: column.preferred-height;
    accessible-role: AccessibleRole.groupbox;
    accessible-label: root.text;
    accessible-expandable: true;
    accessible-expanded: root.open;
    accessible-action-expand => { root.toggle(); }

    function toggle() {
        root.open = !root.open;
        root.toggled(root.open);
    }

    column := VerticalLayout {
        alignment: start;
        spacing: Theme.space-1;
        header := Rectangle {
            height: Theme.compact-row;
            background: touch.has-hover ? Theme.current.ghost-hover : transparent;
            border-radius: Theme.radius-md;
            opacity: root.enabled ? 1 : 0.5;

            HorizontalLayout {
                padding-left: Theme.compact-pad;
                padding-right: Theme.compact-pad;
                spacing: Theme.space-1-5;
                Text {
                    text: root.text;
                    color: Theme.current.foreground;
                    font-family: Typography.compact-label.font-family;
                    font-size: Typography.compact-label.font-size;
                    font-weight: Typography.compact-label.font-weight;
                    vertical-alignment: center;
                    overflow: elide;
                }
                Path {
                    width: Theme.icon-md;
                    height: Theme.icon-md;
                    y: (parent.height - self.height) / 2;
                    viewbox-width: 16;
                    viewbox-height: 16;
                    commands: root.open ? "M4 9.5 L8 5.5 L12 9.5" : "M4 6.5 L8 10.5 L12 6.5";
                    stroke: Theme.current.muted-foreground;
                    stroke-width: 1.5px;
                    stroke-line-cap: round;
                    stroke-line-join: round;
                    fill: transparent;
                }
            }

            touch := TouchArea {
                enabled: root.enabled;
                mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
                clicked => { root.toggle(); }
            }

            FocusScope {
                enabled: root.enabled;
                focus-on-click: false;
                focus-gained(reason) => { root.keyboard-focus = reason == FocusReason.tab-navigation; }
                focus-lost(reason) => { root.keyboard-focus = false; }
                key-pressed(event) => {
                    if (event.text == " " || event.text == Key.Return) {
                        root.toggle();
                        return accept;
                    }
                    return reject;
                }
            }

            if root.keyboard-focus : FocusRing {
                radius: Theme.radius-md;
                host-width: parent.width;
                host-height: parent.height;
            }
        }
        // The children stay in the tree; a closed collapsible hides them and takes no height.
        Rectangle {
            visible: root.open;
            height: root.open ? content.preferred-height : 0px;
            clip: true;
            content := VerticalLayout {
                alignment: start;
                @children
            }
        }
    }
}
