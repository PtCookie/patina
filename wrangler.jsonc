{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "patina",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "workers_dev": false,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "patina.ptcookie.net",
      "custom_domain": true
    }
  ],
  // Static assets only: the generated registry, token files and fonts. No Worker script.
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true
    }
  }
}
